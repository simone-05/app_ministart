<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="start"
    android:padding="24dp"
    android:background="?android:attr/colorBackground"
    android:alpha="0"
    >

    <!-- Settings Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="22dp"
        android:fontFamily="sans-serif"
        />

    <!-- Wallpaper Settings -->
    <TextView
        android:id="@+id/wallpaperHelperText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To change wallpaper activate the switch"
        android:textSize="16sp"
        android:layout_marginTop="14dp"
        android:alpha="0.7"
        />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/useWallpapersSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Use custom wallpapers"
        android:layout_marginTop="16dp"
        android:checked="false"
        app:useMaterialThemeColors="true"
        />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_weight="1"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectSystemWallpaperButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change System Wallpaper"
                android:textSize="16sp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                />

            <!-- Dark wallpaper buttons -->
            <LinearLayout
                android:id="@+id/darkWallpaperLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone"
                >

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/activateDarkWallpaperSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="12dp"
                    android:text=""
                    app:useMaterialThemeColors="true"
                    android:checked="true"
                    android:visibility="gone"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/selectDarkWallpaperButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Set Dark Wallpaper"
                    android:textSize="16sp"
                    android:enabled="true"
                    />
            </LinearLayout>

            <!-- Text color settings -->
            <LinearLayout
                android:id="@+id/textColorLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="start"
                android:orientation="vertical"
                android:visibility="gone"
                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Text Color"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    />

                <RadioGroup
                    android:id="@+id/textColorRadioGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    >

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/lightTextRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light text"
                        app:useMaterialThemeColors="true"
                        />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/darkTextRadioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark text"
                        app:useMaterialThemeColors="true"
                        />

                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Go Back button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back"
        android:layout_marginTop="14dp"
        />

</LinearLayout>